{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omludo",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ROOM_KV",
      "id": "be96f2732d9f42f4b66ab19110dbf974"
    }
  ],
  "observability": {
    "enabled": true
  }
}
